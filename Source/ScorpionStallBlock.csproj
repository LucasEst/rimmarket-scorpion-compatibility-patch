<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <GameVersion Condition="'$(GameVersion)' == ''">1.7</GameVersion>
    <TargetFramework Condition="'$(GameVersion)' == '1.6'">net48</TargetFramework>
    <TargetFramework Condition="'$(GameVersion)' == '1.7'">net10.0</TargetFramework>
    <AssemblyName>ScorpionStallBlock</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>none</DebugType>
    <OutputPath>../$(GameVersion)/Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GameDir Condition="'$(GameDir)' == ''">$(MSBuildThisFileDirectory)../../..</GameDir>
    <HarmonyRoot Condition="'$(HarmonyRoot)' == ''">C:/Program Files (x86)/Steam/steamapps/workshop/content/294100/2009463077</HarmonyRoot>
  </PropertyGroup>
  <ItemGroup Condition="'$(GameVersion)' == '1.6'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup Condition="'$(GameVersion)' == '1.7'">
    <Reference Include="Assembly-CSharp"><HintPath>$(GameDir)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="0Harmony"><HintPath>$(HarmonyRoot)/$(GameVersion)/Assemblies/0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
